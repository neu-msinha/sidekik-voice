{
  "name": "sidekik-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekik ElevenLabs layer: agents as code, conversation tokens, transcripts, post-call webhook, Work Map sync",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mock": "tsx watch src/dev/mock.ts",
    "agents:push": "tsx --env-file-if-exists=.env scripts/agents.ts push",
    "agents:webhook": "tsx --env-file-if-exists=.env scripts/agents.ts webhook"
  },
  "dependencies": {
    "@sidekik/contracts": "github:sidekik-live/sidekik-platform#v0.3.2",
    "@supabase/supabase-js": "^2",
    "fastify": "^5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "pino-pretty": "^13.1.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
